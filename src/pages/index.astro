---
// TIER 4: PAGE — Home
// Contextual view: composes patterns + primitives inside a semantic
// 12-column grid. All copy is lorem ipsum; images from Unsplash.
import '../styles/tokens.css';
import Bento, { type BentoCell } from '../components/Bento.astro';
import SearchBar from '../components/patterns/SearchBar.astro';
import Button from '../components/ui/Button.astro';
import GridOverlay from '../components/GridOverlay.astro';

const nav = [
  { label: 'About', href: '#about' },
  { label: 'Portfolio', href: '#work' },
  { label: 'Themes', href: '#themes' },
  { label: 'Services', href: '#process' },
];

const benefits = [
  'Lorem ipsum dolor sit amet, consectetur adipiscing elit sed.',
  'Lorem ipsum dolor sit amet, consectetur adipiscing elit sed.',
  'Lorem ipsum dolor sit amet, consectetur adipiscing elit sed.',
  'Lorem ipsum dolor sit amet, consectetur adipiscing elit sed.',
];

// Benefits — Bento canvas (docs/spec-bento.md §9.3):
// 12 cols × 2 rows, square unit, flush. Intro card c1-6 r1-2 (slot cell-0);
// four brand cards as 3-col cells. Total cell area: 12 + 3×4 = 24 = 12 × 2 ✓
const benefitsCells: BentoCell[] = [
  { c: [1, 6], r: [1, 2], finish: 'card', class: 'bento-cell--intro' },
  { c: [7, 9], r: [1, 1], finish: 'card', class: 'bento-cell--brand' },
  { c: [10, 12], r: [1, 1], finish: 'card', class: 'bento-cell--brand' },
  { c: [7, 9], r: [2, 2], finish: 'card', class: 'bento-cell--brand' },
  { c: [10, 12], r: [2, 2], finish: 'card', class: 'bento-cell--brand' },
];

// Hero media strip — Bento canvas (docs/spec-bento.md §9.1):
// 12 cols × 4 rows, square unit, flush, mask finish. ONE shared image
// exposed through N clip-mask windows; exactly one cell carries the alt.
// Mega-columns: 4 cols = 1/3 of the canvas. Cells numbered in canvas
// reading order (top-to-bottom, left-to-right); cell 7 = rightmost field.
// Total cell area: 1+3+12+4+8+8+12 = 48 = 12 × 4 ✓
const MEDIA_STRIP_SRC =
  'https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?w=1600&q=80&auto=format&fit=crop';
const mediaStripCells: BentoCell[] = [
  { c: [1, 1], r: [1, 1], finish: 'mask', r0: [3, 4], alt: 'Lorem ipsum featured landscape' },
  { c: [1, 1], r: [2, 4], finish: 'mask', r0: [1, 2, 3] },
  { c: [2, 5], r: [1, 3], finish: 'mask', r0: [3, 4] },
  { c: [2, 5], r: [4, 4], finish: 'mask', r0: [1, 2] },
  { c: [6, 9], r: [1, 2], finish: 'mask', r0: [3, 4] },
  { c: [6, 9], r: [3, 4], finish: 'mask', r0: [1, 2] },
  { c: [10, 12], r: [1, 4], finish: 'mask', r0: [1, 4] },
];

const work = [
  {
    src: 'https://images.unsplash.com/photo-1529626455594-4ff0802cfb7e?w=800&q=80&auto=format&fit=crop',
    alt: 'Lorem ipsum portrait one',
  },
  {
    src: 'https://images.unsplash.com/photo-1516589178581-6cd7833ae3b2?w=800&q=80&auto=format&fit=crop',
    alt: 'Lorem ipsum portrait two',
  },
  {
    src: 'https://images.unsplash.com/photo-1524504388940-b1c1722653e1?w=800&q=80&auto=format&fit=crop',
    alt: 'Lorem ipsum portrait three',
  },
  {
    src: 'https://images.unsplash.com/photo-1517841905240-472988babdf9?w=800&q=80&auto=format&fit=crop',
    alt: 'Lorem ipsum portrait four',
  },
  {
    src: 'https://images.unsplash.com/photo-1531746020798-e6953c6e8e04?w=800&q=80&auto=format&fit=crop',
    alt: 'Lorem ipsum portrait five',
  },
  {
    src: 'https://images.unsplash.com/photo-1506794778202-cad84cf45f1e?w=800&q=80&auto=format&fit=crop',
    alt: 'Lorem ipsum portrait six',
  },
];

// Work gallery — Bento canvas (docs/spec-bento.md §9.2):
// 12 cols × 3 rows, square unit, flush. Label card c1-3 r1-3 (card finish,
// content via slot cell-0); eight crop cells fill c4-12.
// Total cell area: 9+2+2+2+6+3+6+3+3 = 36 = 12 × 3 ✓
const workCells: BentoCell[] = [
  { c: [1, 3],   r: [1, 3], finish: 'card', class: 'bento-cell--label' },
  { c: [4, 5],   r: [1, 1], finish: 'crop', src: work[0].src, alt: work[0].alt },
  { c: [6, 6],   r: [1, 2], finish: 'crop', src: work[2].src, alt: work[2].alt },
  { c: [4, 5],   r: [2, 2], finish: 'crop', src: work[5].src, alt: work[5].alt },
  { c: [7, 12],  r: [1, 1], finish: 'crop', src: work[1].src, alt: work[1].alt },
  { c: [7, 9],   r: [2, 2], finish: 'crop', src: work[2].src, alt: work[2].alt },
  { c: [10, 12], r: [2, 3], finish: 'crop', src: work[3].src, alt: work[3].alt },
  { c: [4, 6],   r: [3, 3], finish: 'crop', src: work[4].src, alt: work[4].alt },
  { c: [7, 9],   r: [3, 3], finish: 'crop', src: work[5].src, alt: work[5].alt },
];

const steps = [
  {
    num: '01',
    title: 'Lorem ipsum dolor',
    body: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit sed do eiusmod tempor.',
  },
  {
    num: '02',
    title: 'Lorem ipsum dolor',
    body: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit sed do eiusmod tempor.',
  },
  {
    num: '03',
    title: 'Lorem ipsum dolor',
    body: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit sed do eiusmod tempor.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Lorem Ipsum — Portfolio Prototype</title>
    <meta name="description" content="Lorem ipsum dolor sit amet, consectetur adipiscing elit." />
  </head>
  <body>
    <!-- TEMPORARY: design QA overlay — press "g" to toggle. Remove before production. -->
    <GridOverlay />
    <!-- ============ HEADER ============ -->
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="site-header__brand" href="/">
          <span class="site-header__mark" aria-hidden="true"></span>
          Lorem Ipsum
        </a>
        <nav class="site-header__nav" aria-label="Primary">
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <div class="site-header__actions">
          <Button variant="inverse" size="sm" href="#contact" aria-label="Get in touch" class="site-header__action">↗</Button>
        </div>
      </div>
    </header>

    <main class="container">
      <!-- ============ HERO ============ -->
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero__copy">
          <h1 id="hero-title">Lorem ipsum.<br />Lorem ipsum dolor.</h1>
        </div>
        <div class="hero__aside">
          <p class="hero__tagline">Lorem ipsum dolor sit amet. Lorem ipsum dolor sit amet.</p>
          <Button variant="inverse" size="md" href="#contact">Lorem ipsum ↗</Button>
        </div>
      </section>

      <!-- ============ HERO MEDIA STRIP ============ -->
      <!-- Bento canvas: 12×4, square unit, flush, mask finish (spec §9.1).
           One shared image, 7 clip-mask windows; mask 1 carries the alt. -->
      <Bento
        rows={4}
        density="flush"
        image={MEDIA_STRIP_SRC}
        cells={mediaStripCells}
        ariaLabel="Featured imagery"
        class="media-strip"
      />

      <!-- ============ INTRO ============ -->
      <section class="intro" id="about" aria-labelledby="intro-title">
        <h2 id="intro-title">
          Lorem ipsum dolor sit amet,
          <span class="intro__highlight"><span class="intro__highlight-star" aria-hidden="true">✳</span>lorem ipsum dolor</span>. Lorem ipsum dolor sit amet,
          consectetur adipiscing <span class="intro__emoji">🙂</span> lorem ipsum dolor.
        </h2>
        <Button variant="inverse" size="md" href="#contact">Lorem ipsum ↗</Button>
      </section>

      <!-- ============ BENEFITS ============ -->
      <!-- Bento canvas: 12×2, square unit, flush (spec §9.3).
           Intro card + four brand cards, content via named slots. -->
      <Bento
        rows={2}
        density="flush"
        cells={benefitsCells}
        ariaLabel="Lorem ipsum dolor sit amet"
        class="benefits"
      >
        <div slot="cell-0" class="benefits__intro">
          <h2>Lorem ipsum<br />dolor sit amet</h2>
          <span class="benefits__arrow" aria-hidden="true">→</span>
        </div>
        <div slot="cell-1" class="benefits__card">
          <p>{benefits[0]}</p>
          <span class="benefits__icon" aria-hidden="true">◎</span>
        </div>
        <div slot="cell-2" class="benefits__card">
          <p>{benefits[1]}</p>
          <span class="benefits__icon" aria-hidden="true">◎</span>
        </div>
        <div slot="cell-3" class="benefits__card">
          <p>{benefits[2]}</p>
          <span class="benefits__icon" aria-hidden="true">◎</span>
        </div>
        <div slot="cell-4" class="benefits__card">
          <p>{benefits[3]}</p>
          <span class="benefits__icon" aria-hidden="true">◎</span>
        </div>
      </Bento>
      <!-- ============ SEARCH (pattern deployment) ============ -->
      <section class="search-section" id="themes" aria-labelledby="search-title">
        <h2 id="search-title">Lorem ipsum</h2>
        <p class="search-section__lede">Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
        <SearchBar placeholder="Lorem ipsum dolor sit amet" buttonLabel="Lorem ipsum" />
      </section>

      <!-- ============ WORK GALLERY ============ -->
      <!-- Bento canvas: 12×3, square unit, flush (spec §9.2).
           Label card (slot cell-0) + six crop cells filling c4-12. -->
      <Bento
        rows={3}
        density="flush"
        cells={workCells}
        ariaLabel="Lorem ipsum"
        class="work"
      >
        <div slot="cell-0" class="work__label">
          <h2>Lorem<br />ipsum</h2>
          <span class="work__badge" aria-hidden="true">✦</span>
        </div>
      </Bento>

      <!-- ============ PROCESS ============ -->
      <section class="process" id="process" aria-labelledby="process-title">
        <div class="process__head">
          <h2 id="process-title">Lorem ipsum dolor</h2>
          <p class="process__lede">Lorem ipsum dolor sit amet, consectetur adipiscing elit sed.</p>
        </div>
        <ol class="process__list">
          {
            steps.map((step, i) => (
              <li class:list={['process__step', { 'process__step--active': i === 1 }]}>
                <span class="process__num">{step.num}</span>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <!-- ============ CONTACT ============ -->
      <section class="contact" id="contact" aria-labelledby="contact-title">
        <h2 id="contact-title">Work with me</h2>
        <p class="contact__lede">Directly, or through your prime contractor.</p>
        <Button variant="primary" size="lg" href="mailto:hello@dalerogers.com.au?subject=Project%20enquiry">Email me ↗</Button>
        <a class="contact__email" href="mailto:hello@dalerogers.com.au">hello@dalerogers.com.au</a>
        <p class="contact__meta">Founder, Common Standing · Canberra, Ngunnawal Country</p>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container site-footer__inner">
        <p>© 2026 Lorem Ipsum. Lorem ipsum dolor sit amet.</p>
        <nav aria-label="Footer">
          <a href="#about">Lorem</a>
          <a href="#work">Ipsum</a>
          <a href="#contact">Dolor</a>
        </nav>
      </div>
    </footer>
  </body>
</html>

<style>
  /* ---------- Page base ---------- */
  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    font-family: var(--global-font-sans);
    font-size: var(--type-body);
    line-height: var(--global-leading-normal);
    color: var(--color-text-body);
    /* Full-bleed page: the canvas IS the paper (docs/spec-full-bleed-page.md).
       Cream edge to edge; .container is the only centring mechanism. */
    background-color: var(--color-bg-page);
    -webkit-font-smoothing: antialiased;
  }

  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  h1,
  h2,
  h3 {
    font-family: var(--global-font-display);
    color: var(--color-text-heading);
    line-height: var(--global-leading-tight);
    margin: 0;
    /* Optical alignment: trim leading above cap-height and below baseline
       so headings align visually, not just mathematically. */
    text-box-trim: trim-both;
    text-box-edge: cap alphabetic;
  }

  /* Typography drives vertical rhythm: heading→body spacing scales with
     the heading's own size (em-based), not a fixed pixel value. */
  h2,
  h3 {
    margin-block-start: var(--rhythm-heading-before);
    margin-block-end: var(--rhythm-heading-after);
  }

  /* Sections and layout regions reset the rhythm — section gap is the
     only large vertical beat, applied single-direction. */
  h2:first-child,
  h3:first-child {
    margin-block-start: 0;
  }

  /* ---------- Layout: horizontal grid + vertical rhythm ---------- */
  .container {
    max-width: var(--global-container-max);
    margin-inline: auto;
    padding-inline: var(--global-container-pad);
  }

  /* :global() so the rhythm also hits sections rendered by child
     components (Bento.astro) — Astro scoping would otherwise exclude
     them, since they carry the component's cid, not the page's. */
  main > :global(section) {
    margin-block-end: var(--spacing-section);
  }

  /* ---------- Header ---------- */
  .site-header {
    padding-block: var(--spacing-padding-md);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--spacing-gap-lg);
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-gap-sm);
    font-weight: var(--global-weight-semibold);
    color: var(--color-text-heading);
    text-decoration: none;
  }

  .site-header__mark {
    inline-size: 1.5rem;
    block-size: 1.5rem;
    border-radius: var(--global-radius-pill);
    background-color: var(--color-bg-inverse);
  }

  .site-header__nav {
    display: flex;
    gap: var(--spacing-gap-lg);
    margin-inline-start: auto;
  }

  .site-header__nav a {
    color: var(--color-text-body);
    text-decoration: none;
    font-size: var(--global-type-step--1);
  }

  .site-header__nav a:hover {
    color: var(--color-text-accent);
  }

  /* Reference header action: a small circular icon button, not a pill. */
  .site-header__action {
    inline-size: 2.5rem;
    block-size: 2.5rem;
    padding: 0;
    border-radius: var(--global-radius-pill);
  }

  /* ---------- Hero ---------- */
  .hero {
    display: grid;
    grid-template-columns: repeat(var(--global-grid-columns), minmax(0, 1fr));
    gap: var(--grid-gutter); /* density: spaced (layout regions) */
    align-items: end;
    padding-block: var(--global-space-xl) var(--global-space-lg);
  }

  .hero__copy {
    grid-column: 1 / span 7;
  }

  .hero__copy h1 {
    font-size: var(--type-hero);
    font-weight: var(--global-weight-semibold);
    letter-spacing: -0.02em;
  }

  .hero__aside {
    grid-column: 9 / span 4;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-gap-md);
  }

  .hero__tagline {
    margin: 0;
    font-size: var(--global-type-step--1);
    color: var(--color-text-muted);
  }

  /* ---------- Media strip ---------- */
  /* Grid mechanics (canvas, rows, mask math) live in Bento.astro.
     This page styles only surfaces. */

  /* ---------- Intro ---------- */
  .intro {
    text-align: center;
    max-width: 42rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-gap-lg);
  }

  .intro h2 {
    font-size: var(--type-h3);
    font-weight: var(--global-weight-semibold);
  }

  /* Reference intro highlight: an outlined pill around the phrase,
     with a small star glyph leading it. */
  .intro__highlight {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-gap-sm);
    padding-inline: var(--spacing-padding-sm);
    border: var(--global-border-width-hairline) solid var(--color-text-heading);
    border-radius: var(--global-radius-pill);
  }

  .intro__highlight-star {
    color: var(--color-text-accent);
    font-size: 0.8em;
  }

  .intro__emoji {
    display: inline-grid;
    place-items: center;
    inline-size: 1.4em;
    block-size: 1.4em;
    border-radius: var(--global-radius-pill);
    background-color: var(--color-bg-brand);
    font-size: 0.7em;
    vertical-align: middle;
  }

  /* ---------- Benefits ---------- */
  /* Grid mechanics live in Bento.astro; surfaces only here. */
  .benefits__intro {
    display: flex;
    flex-direction: row;
    align-items: flex-end; /* h2 + arrow bottom-aligned to the card */
    justify-content: space-between;
    gap: var(--spacing-gap-lg);
    padding: var(--spacing-padding-lg);
    block-size: 100%;
    background-color: var(--color-bg-muted);
    border-radius: var(--radius-card);
  }

  .benefits__intro h2 {
    font-size: var(--type-h3);
    text-align: left;
  }

  .benefits__arrow {
    font-size: var(--type-h2);
    color: var(--color-text-heading);
    margin-inline-start: auto;
  }

  .benefits__card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--spacing-gap-lg);
    padding: var(--spacing-padding-md);
    block-size: 100%;
    background-color: var(--color-bg-brand);
    color: var(--color-text-on-brand);
    border-radius: var(--radius-card);
  }

  .benefits__card p {
    margin: 0;
    font-size: var(--global-type-step--1);
    font-weight: var(--global-weight-medium);
  }

  .benefits__icon {
    display: inline-grid;
    place-items: center;
    inline-size: 2rem;
    block-size: 2rem;
    border-radius: var(--global-radius-pill);
    background-color: color-mix(in srgb, var(--color-bg-inverse) 20%, transparent);
  }

  /* ---------- Search section ---------- */
  .search-section {
    max-width: 42rem;
    margin-inline: auto;
    text-align: center;
  }

  .search-section h2 {
    font-size: var(--type-h2);
  }

  .search-section__lede {
    color: var(--color-text-muted);
  }

  /* ---------- Work gallery ---------- */
  /* Grid mechanics live in Bento.astro; surfaces only here. */
  .work__label {
    display: flex;
    flex-direction: row;
    align-items: flex-end; /* h2 + badge bottom-aligned to the card */
    justify-content: space-between; /* badge right-aligned */
    gap: var(--spacing-gap-lg);
    padding: var(--spacing-padding-lg);
    block-size: 100%;
    background-color: var(--color-bg-inverse);
    color: var(--color-text-on-inverse);
    border-radius: var(--radius-card);
  }

  .work__label h2 {
    font-size: var(--type-h2);
  }

  .work__badge {
    display: inline-grid;
    place-items: center;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    border-radius: var(--global-radius-pill);
    background-color: color-mix(in srgb, var(--color-bg-inverse) 0%, transparent);
    color: inherit;
    border: 1px solid currentColor;
  }

  /* ---------- Process ---------- */
  .process__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-gap-lg);
    margin-block-end: var(--spacing-gap-lg);
  }

  .process__head h2 {
    font-size: var(--type-h2);
  }

  .process__lede {
    max-width: 20rem;
    margin: 0;
    font-size: var(--global-type-step--1);
    color: var(--color-text-muted);
  }

  .process__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .process__step {
    display: grid;
    grid-template-columns: auto 1fr 1fr;
    align-items: center;
    gap: var(--spacing-gap-lg);
    padding-block: var(--spacing-padding-md);
    border-block-start: var(--global-border-width-hairline) solid var(--color-border-subtle);
  }

  .process__num {
    display: inline-grid;
    place-items: center;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    border-radius: var(--global-radius-pill);
    font-size: var(--global-type-step--1);
    color: var(--color-text-muted);
    border: var(--global-border-width-hairline) solid var(--color-border-subtle);
  }

  .process__step--active .process__num {
    background-color: var(--color-bg-inverse);
    color: var(--color-text-on-inverse);
    border-color: var(--color-bg-inverse);
  }

  .process__step h3 {
    font-size: var(--type-h4);
  }

  .process__step p {
    margin: 0;
    font-size: var(--global-type-step--1);
    color: var(--color-text-muted);
  }

  /* ---------- Contact ---------- */
  .contact {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-gap-lg);
    padding: var(--spacing-padding-xl);
    text-align: center;
    background-color: var(--color-bg-surface);
    border-radius: var(--radius-card);
  }

  .contact h2 {
    font-size: var(--type-h2);
  }

  .contact__lede {
    max-width: 44ch;
    color: var(--color-text-muted);
  }

  .contact__email {
    color: var(--color-text-heading);
    text-underline-offset: 0.2em;
  }

  .contact__meta {
    font-size: var(--global-type-step--1);
    color: var(--color-text-muted);
  }

  /* ---------- Footer ---------- */
  .site-footer {
    padding-block: var(--spacing-padding-lg);
    border-block-start: var(--global-border-width-hairline) solid var(--color-border-subtle);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--spacing-gap-md);
    font-size: var(--global-type-step--1);
    color: var(--color-text-muted);
  }

  .site-footer__inner nav {
    display: flex;
    gap: var(--spacing-gap-lg);
  }

  .site-footer__inner a {
    color: inherit;
