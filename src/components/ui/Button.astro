---
// TIER 2: BASE COMPONENT — Button
// Pure primitive: no imports, no nested components, no hardcoded
// colors or dimensions. All styling maps to semantic tokens.
interface Props extends astroHTML.JSX.HTMLAttributes {
  variant?: 'primary' | 'inverse' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit' | 'reset';
  href?: string;
}

const {
  variant = 'primary',
  size = 'md',
  type = 'button',
  href,
  class: className,
  ...rest
} = Astro.props;

const classes = ['btn', `btn--${variant}`, `btn--${size}`, className].filter(Boolean).join(' ');
---

{
  href ? (
    <a href={href} class={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} {...rest}>
      <slot />
    </button>
  )
}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-gap-sm);
    font-family: inherit;
    font-size: var(--type-body);
    font-weight: var(--global-weight-medium);
    line-height: var(--global-leading-tight);
    text-decoration: none;
    cursor: pointer;
    border: var(--global-border-width-hairline) solid transparent;
    border-radius: var(--radius-control);
    transition:
      background-color var(--global-duration-fast) var(--global-ease-out),
      color var(--global-duration-fast) var(--global-ease-out),
      border-color var(--global-duration-fast) var(--global-ease-out);
  }

  /* SC 2.4.11/2.4.13: the ring must clear 3:1 against the page AND against
     the button's own fill. --color-border-focus is orange-500, which is
     4.73:1 on the cream page and 4.73:1 on the brand fill. */
  .btn:focus-visible {
    outline: 2px solid var(--color-border-focus);
    outline-offset: 2px;
  }

  /* SC 2.5.8 Target Size (Minimum): 24 × 24 CSS px. The sm size is the
     tightest — its padding alone does not reach 24px at the small end. */
  .btn {
    min-block-size: 1.5rem;
    min-inline-size: 1.5rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .btn {
      transition: none;
    }
  }

  /* Sizes — padding from semantic spacing tokens */
  .btn--sm {
    padding: var(--spacing-padding-xs) var(--spacing-padding-md);
  }
  .btn--md {
    padding: var(--spacing-padding-sm) var(--spacing-padding-lg);
  }
  .btn--lg {
    padding: var(--spacing-padding-md) var(--spacing-padding-xl);
    font-size: var(--type-lede);
  }

  /* Variants — colors from semantic color tokens */
  .btn--primary {
    background-color: var(--color-bg-brand);
    color: var(--color-text-on-brand);
  }
  .btn--primary:hover {
    background-color: var(--color-bg-brand-hover);
  }

  .btn--inverse {
    background-color: var(--color-bg-inverse);
    color: var(--color-text-on-inverse);
  }
  .btn--inverse:hover {
    background-color: var(--color-bg-inverse-hover);
  }

  .btn--ghost {
    background-color: transparent;
    color: var(--color-text-heading);
    border-color: var(--color-border-strong);
  }
  .btn--ghost:hover {
    background-color: var(--color-bg-muted);
  }
</style>
